<UserControl
    x:Class="WPFDevelopers.Demo.DemoPages.AutoCompleteBoxDemo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="AutoCompleteBox" />
         <AutoCompleteBox
                        x:Name="DemoAutoCompleteBox"
                        Width="200"
                        HorizontalAlignment="Left"
                        FilterMode="Contains"
                        Watermark="Search..." />
    </StackPanel>
</UserControl>
