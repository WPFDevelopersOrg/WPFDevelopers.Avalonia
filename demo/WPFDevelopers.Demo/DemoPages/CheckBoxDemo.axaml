<UserControl
    x:Class="WPFDevelopers.Demo.DemoPages.CheckBoxDemo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="CheckBox" />
           <CheckBox Content="CheckBox (checked)" IsChecked="True" />
                        <CheckBox Content="CheckBox (unchecked)" />
                        <CheckBox
                            Content="CheckBox (indeterminate)"
                            IsChecked="{x:Null}"
                            IsThreeState="True" />
    </StackPanel>
</UserControl>
