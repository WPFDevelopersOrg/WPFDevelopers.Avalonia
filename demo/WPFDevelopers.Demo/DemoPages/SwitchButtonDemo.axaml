<UserControl
    x:Class="WPFDevelopers.Demo.DemoPages.SwitchButtonDemo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WPFDevelopers.Demo"
    xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Svg.Controls.Avalonia"
    xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers.Avalonia">
    <UserControl.Resources>
        <local:SvgBrushToCssConverter x:Key="SvgBrushToCssConverter" />
    </UserControl.Resources>
    <StackPanel Spacing="14">
        <TextBlock Text="图标与组合内容" />
        <wd:SwitchButton HorizontalAlignment="Left"
                         AutomationProperties.Name="收藏">
            <wd:SwitchButton.UncheckedContent>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <wd:PathIconEx Width="20" Height="20" Kind="Star" />
                    <TextBlock VerticalAlignment="Center" Text="收藏" />
                </StackPanel>
            </wd:SwitchButton.UncheckedContent>
            <wd:SwitchButton.CheckedContent>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <wd:PathIconEx Width="20" Height="20" Kind="Star"
                                   Foreground="{DynamicResource WD.WarningBrush}" />
                    <TextBlock VerticalAlignment="Center" Text="已收藏" />
                </StackPanel>
            </wd:SwitchButton.CheckedContent>
        </wd:SwitchButton>

        <TextBlock Text="SVG 与图片（内容直接传入控件，无需专用图片属性）" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <wd:SwitchButton AutomationProperties.Name="SVG 内容切换">
                <wd:SwitchButton.UncheckedContent>
                    <svg:Svg Width="32" Height="32"
                             Path="avares://WPFDevelopers.Demo/Assets/MenuIcons/Checkbox.svg"
                             svg:Svg.CurrentCss="{Binding Foreground, RelativeSource={RelativeSource AncestorType=wd:SwitchButton}, Converter={StaticResource SvgBrushToCssConverter}}" />
                </wd:SwitchButton.UncheckedContent>
                <wd:SwitchButton.CheckedContent>
                    <svg:Svg Width="32" Height="32"
                             Path="avares://WPFDevelopers.Demo/Assets/MenuIcons/ToggleButton.svg"
                             svg:Svg.CurrentCss="{Binding Foreground, RelativeSource={RelativeSource AncestorType=wd:SwitchButton}, Converter={StaticResource SvgBrushToCssConverter}}" />
                </wd:SwitchButton.CheckedContent>
            </wd:SwitchButton>
            <wd:SwitchButton AutomationProperties.Name="图片内容切换">
                <wd:SwitchButton.UncheckedContent>
                    <Image Width="64" Height="64"
                           Source="avares://WPFDevelopers.Demo/Assets/WPFDevelopers.ico" Stretch="Uniform" />
                </wd:SwitchButton.UncheckedContent>
                <wd:SwitchButton.CheckedContent>
                    <Image Width="64" Height="64"
                           Source="avares://WPFDevelopers.Demo/Assets/wxgzh.jpg" Stretch="Uniform" />
                </wd:SwitchButton.CheckedContent>
            </wd:SwitchButton>
        </StackPanel>

        <TextBlock Text="明暗主题（与应用实际主题同步，选中表示深色）" />
        <wd:SwitchButton x:Name="ThemeSwitch"
                         HorizontalAlignment="Left"
                         
                         AutomationProperties.Name="深色主题"
                         Click="OnThemeSwitchClick">
                <wd:SwitchButton.UncheckedContent>
                    <PathIcon
    Width="18"
    Height="18"
    Data="M12 19a7 7 0 1 1 0-14 7 7 0 0 1 0 14Zm0-1.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 1 0 0 11Zm-5.657.157a.75.75 0 0 1 0 1.06l-1.768 1.768a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734l1.767-1.768a.75.75 0 0 1 1.061 0ZM3.515 3.515a.75.75 0 0 1 1.06 0l1.768 1.768a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215L3.515 4.575a.75.75 0 0 1 0-1.06ZM12 0a.75.75 0 0 1 .75.75v2.5a.75.75 0 0 1-1.5 0V.75A.75.75 0 0 1 12 0ZM4 12a.75.75 0 0 1-.75.75H.75a.75.75 0 0 1 0-1.5h2.5A.75.75 0 0 1 4 12Zm8 8a.75.75 0 0 1 .75.75v2.5a.75.75 0 0 1-1.5 0v-2.5A.75.75 0 0 1 12 20Zm12-8a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h2.5A.75.75 0 0 1 24 12Zm-6.343 5.657a.75.75 0 0 1 1.06 0l1.768 1.768a.751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018l-1.768-1.767a.75.75 0 0 1 0-1.061Zm2.828-14.142a.75.75 0 0 1 0 1.06l-1.768 1.768a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042l1.767-1.768a.75.75 0 0 1 1.061 0Z"
    Foreground="{DynamicResource WD.PrimaryTextBrush}" />
                </wd:SwitchButton.UncheckedContent>
                <wd:SwitchButton.CheckedContent>
                    <Border
    Width="18"
    Height="18"
    Background="{DynamicResource WD.BackgroundBrush}"
    CornerRadius="10">
    <PathIcon
        Width="16"
        Height="16"
        Data="M12 2a10 10 0 1 0 10 10A7 7 0 0 1 12 2Z"
        Foreground="{DynamicResource WD.PrimaryTextBrush}" />
</Border>
                </wd:SwitchButton.CheckedContent>
            </wd:SwitchButton>
    </StackPanel>
</UserControl>
