<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>WPFDevelopers.Demo</RootNamespace>
		<AssemblyName>WPFDevelopers.Demo</AssemblyName>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<ApplicationIcon>Assets\WPFDevelopers.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Assets\WPFDevelopers.png" />
		<AvaloniaResource Include="Assets\**\*" />
		<AvaloniaResource Include="Assets\WPFDevelopers.ico" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="DemoPages\*.axaml;DemoPages\*.axaml.cs">
			<LogicalName>WPFDevelopers.Demo.DemoPages.%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.2" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
		<PackageReference Include="Svg.Controls.Avalonia" Version="12.0.0.17" />
		<PackageReference Include="WPFDevelopers.Avalonia" Version="12.1.2-preview" />
	</ItemGroup>

</Project>
