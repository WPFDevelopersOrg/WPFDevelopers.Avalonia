<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource WD.ScrollBarThumbBrush}" />
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource WD.ScrollBarThumbPointerOverBrush}" />
        </Style>
        <Style Selector="^:pointerover /template/ Thumb#PART_Thumb">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="^ /template/ Thumb#PART_Thumb:pressed">
            <Setter Property="Background" Value="{DynamicResource WD.ScrollBarThumbPointerOverBrush}" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="^:horizontal">
            <Setter Property="Height" Value="{DynamicResource WD.ScrollBarSize}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            UseLayoutRounding="False">
                        <Track Name="PART_Track"
                               Orientation="Horizontal"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Value="{TemplateBinding Value, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_LineUpButton"
                                              Focusable="False"
                                              Background="Transparent"
                                              BorderThickness="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_LineDownButton"
                                              Focusable="False"
                                              Background="Transparent"
                                              BorderThickness="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseButton>
                            <Thumb Name="PART_Thumb"
                                   Background="{TemplateBinding Foreground}">
                                <Thumb.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Height" Duration="0:0:0.1" />
                                    </Transitions>
                                </Thumb.Transitions>
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Name="thumbBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="{DynamicResource WD.CornerRadius}"
                                                UseLayoutRounding="False" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^:vertical">
            <Setter Property="Width" Value="{DynamicResource WD.ScrollBarSize}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            UseLayoutRounding="False">
                        <Track Name="PART_Track"
                               Orientation="Vertical"
                               IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Value="{TemplateBinding Value, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_LineUpButton"
                                              Focusable="False"
                                              Background="Transparent"
                                              BorderThickness="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_LineDownButton"
                                              Focusable="False"
                                              Background="Transparent"
                                              BorderThickness="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseButton>
                            <Thumb Name="PART_Thumb"
                                   Background="{TemplateBinding Foreground}">
                                <Thumb.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Width" Duration="0:0:0.1" />
                                    </Transitions>
                                </Thumb.Transitions>
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Name="thumbBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="{DynamicResource WD.CornerRadius}"
                                                UseLayoutRounding="False" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="^:horizontal /template/ Thumb#PART_Thumb">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Height" Value="{DynamicResource WD.ScrollBarThumbSize}" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="^:vertical /template/ Thumb#PART_Thumb">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Width" Value="{DynamicResource WD.ScrollBarThumbSize}" />
            <Setter Property="Margin" Value="0,0,1,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="^:horizontal:pointerover /template/ Thumb#PART_Thumb">
            <Setter Property="Height" Value="{DynamicResource WD.ScrollBarThumbExpandedSize}" />
        </Style>
        <Style Selector="^:horizontal /template/ Thumb#PART_Thumb:pressed">
            <Setter Property="Height" Value="{DynamicResource WD.ScrollBarThumbExpandedSize}" />
        </Style>
        <Style Selector="^:vertical:pointerover /template/ Thumb#PART_Thumb">
            <Setter Property="Width" Value="{DynamicResource WD.ScrollBarThumbExpandedSize}" />
        </Style>
        <Style Selector="^:vertical /template/ Thumb#PART_Thumb:pressed">
            <Setter Property="Width" Value="{DynamicResource WD.ScrollBarThumbExpandedSize}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
