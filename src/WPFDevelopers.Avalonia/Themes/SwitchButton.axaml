<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers.Avalonia">
    <ControlTheme x:Key="WD.SwitchButton" TargetType="wd:SwitchButton">
        <Setter Property="Background" Value="{DynamicResource WD.RegularTextBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WD.RegularTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource WD.CornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource WD.Padding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0.4"
                            IsVisible="False"
                            IsHitTestVisible="False" />
                    <ContentPresenter Name="PART_UncheckedContent"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding UncheckedContent}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                    <ContentPresenter Name="PART_CheckedContent"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding CheckedContent}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ ContentPresenter#PART_UncheckedContent">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:checked /template/ ContentPresenter#PART_CheckedContent">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Border">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{DynamicResource WD.EnabledOpacity}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type wd:SwitchButton}"
                  TargetType="wd:SwitchButton"
                  BasedOn="{StaticResource WD.SwitchButton}" />
</ResourceDictionary>
