<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wd="using:WPFDevelopers.Avalonia.Windows"
                    xmlns:lang="https://github.com/WPFDevelopersOrg/WPFDevelopers.Avalonia">
    <ControlTheme x:Key="WD.WindowButton" TargetType="Button" BasedOn="{StaticResource wd-base}">
        <Setter Property="Width" Value="45" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource WD.WindowTextBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="#20FFFFFF" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="#40000000" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="WD.WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WD.WindowButton}">
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="#E81123" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="#C50F1F" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="WD.WindowThemePopupItem" TargetType="Button"
                  BasedOn="{StaticResource wd-normal}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource WD.PrimaryTextBrush}" />
        <Style Selector="^.selected">
            <Setter Property="Foreground" Value="{DynamicResource WD.PrimaryBrush}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource WD.BaseBrush}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource WD.BaseBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type wd:Window}" TargetType="wd:Window"
                  BasedOn="{StaticResource {x:Type Window}}">
        <Setter Property="BorderBrush" Value="{DynamicResource WD.WindowBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TitleBackground" Value="{DynamicResource WD.WindowBorderBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <VisualLayerManager Name="PART_VisualLayerManager">
                    <Panel>
                        <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
                        <Border Name="PART_Border"
                                Margin="{TemplateBinding OffScreenMargin}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Grid Margin="{TemplateBinding OffScreenMargin}" RowDefinitions="Auto,*">
                            <Grid Name="PART_TitleBar" Height="{TemplateBinding TitleHeight}"
                                  Background="{TemplateBinding TitleBackground}"
                                  WindowDecorationProperties.ElementRole="TitleBar">
                                <Grid Name="PART_NormalTitleBar" ColumnDefinitions="Auto,Auto,*,Auto">
                                    <Image Name="PART_TitleBarIcon" Width="16" Height="16" Margin="5,0,0,0"
                                           VerticalAlignment="Center"
                                           WindowDecorationProperties.ElementRole="User" />
                                    <TextBlock Name="PART_Title" Grid.Column="1" Margin="5,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource WD.WindowTextBrush}"
                                               Text="{TemplateBinding Title}" />
                                    <ContentPresenter Grid.Column="2" VerticalAlignment="Center"
                                                      Content="{TemplateBinding TitleBarLayout}"
                                                      WindowDecorationProperties.ElementRole="User" />
                                    <StackPanel Name="PART_CaptionButtons" Grid.Column="3"
                                                Orientation="Horizontal"
                                                WindowDecorationProperties.ElementRole="User">
                                        <Button Name="PART_ThemeSwitchButton"
                                                Width="45"
                                                Theme="{StaticResource WD.WindowButton}"
                                                IsVisible="{TemplateBinding ShowTheme}"
                                                Focusable="True"
                                                IsTabStop="True"
                                                ToolTip.Tip="{lang:Language Key=Theme}"
                                                AutomationProperties.Name="{lang:Language Key=Theme}">
                                            <Grid>
                                                <Path Name="PART_ThemeGlyph" Width="18" Height="18"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="{DynamicResource WD.SystemThemeGeometry}"
                                                      Stretch="Uniform" StrokeJoin="Round"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.1" />
                                                <Popup Name="PART_ThemePopup"
                                                       IsLightDismissEnabled="False"
                                                       VerticalOffset="4"
                                                       Placement="Bottom">
                                                    <Border Background="{DynamicResource WD.BackgroundBrush}"
                                                            BorderBrush="{DynamicResource WD.BaseBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                        <StackPanel Margin="4">
                                                            <Button Name="PART_SystemThemeButton"
                                                                    Theme="{StaticResource WD.WindowThemePopupItem}"
                                                                    AutomationProperties.Name="{lang:Language Key=FollowSystem}">
                                                                <Grid ColumnDefinitions="16,*,16">
                                                                    <Path Width="16" Height="16" VerticalAlignment="Center"
                                                                          Data="{DynamicResource WD.SystemThemeGeometry}"
                                                                          Stretch="Uniform" StrokeJoin="Round" StrokeThickness="1.1"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                                    <TextBlock Grid.Column="1" Margin="10,0,14,0"
                                                                               VerticalAlignment="Center"
                                                                               Text="{lang:Language Key=FollowSystem}" />
                                                                    <PathIcon Name="PART_SystemThemeCheck"
                                                                              Grid.Column="2" Width="12" Height="12"
                                                                              Data="{DynamicResource WD.CheckMarkGeometry}"
                                                                              IsVisible="False" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Name="PART_LightThemeButton"
                                                                    Theme="{StaticResource WD.WindowThemePopupItem}"
                                                                    AutomationProperties.Name="{lang:Language Key=LightMode}">
                                                                <Grid ColumnDefinitions="16,*,16">
                                                                    <Path Width="16" Height="16" VerticalAlignment="Center"
                                                                          Data="{DynamicResource WD.SunGeometry}" Stretch="Uniform"
                                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                                    <TextBlock Grid.Column="1" Margin="10,0,14,0"
                                                                               VerticalAlignment="Center"
                                                                               Text="{lang:Language Key=LightMode}" />
                                                                    <PathIcon Name="PART_LightThemeCheck"
                                                                              Grid.Column="2" Width="12" Height="12"
                                                                              Data="{DynamicResource WD.CheckMarkGeometry}"
                                                                              IsVisible="False" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Name="PART_DarkThemeButton"
                                                                    Theme="{StaticResource WD.WindowThemePopupItem}"
                                                                    AutomationProperties.Name="{lang:Language Key=DarkMode}">
                                                                <Grid ColumnDefinitions="16,*,16">
                                                                    <Path Width="16" Height="16" VerticalAlignment="Center"
                                                                          Data="{DynamicResource WD.MoonGeometry}"
                                                                          Stretch="Uniform" StrokeJoin="Round" StrokeThickness="1.1"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                                    <TextBlock Grid.Column="1" Margin="10,0,14,0"
                                                                               VerticalAlignment="Center"
                                                                               Text="{lang:Language Key=DarkMode}" />
                                                                    <PathIcon Name="PART_DarkThemeCheck"
                                                                              Grid.Column="2" Width="12" Height="12"
                                                                              Data="{DynamicResource WD.CheckMarkGeometry}"
                                                                              IsVisible="False" />
                                                                </Grid>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                        </Button>
                                        <Button Name="PART_MinimizeButton"
                                                Theme="{StaticResource WD.WindowButton}"
                                                AutomationProperties.Name="Minimize"
                                                WindowDecorationProperties.ElementRole="MinimizeButton">
                                            <Rectangle Width="10" Height="0.8" Margin="0,7,0,0"
                                                       HorizontalAlignment="Center"
                                                       Fill="{DynamicResource WD.WindowTextBrush}" />
                                        </Button>
                                        <Button Name="PART_RestoreButton"
                                                Theme="{StaticResource WD.WindowButton}"
                                                IsEnabled="{TemplateBinding CanResize}"
                                                AutomationProperties.Name="Maximize"
                                                WindowDecorationProperties.ElementRole="MaximizeButton">
                                            <Path Name="PART_MaximizeGlyph" Width="10" Height="10" Stretch="Uniform"
                                                  Data="{StaticResource WD.WindowMaximizeGeometry}"
                                                  Fill="{DynamicResource WD.WindowTextBrush}" />
                                        </Button>
                                        <Button Name="PART_CloseButton"
                                                Theme="{StaticResource WD.WindowCloseButton}"
                                                AutomationProperties.Name="Close"
                                                WindowDecorationProperties.ElementRole="CloseButton">
                                            <Path Width="10" Height="10" Stretch="Uniform"
                                                  Data="{StaticResource WD.WindowCloseGeometry}"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <ContentPresenter Name="PART_CustomTitleBar" IsVisible="False"
                                                  Content="{TemplateBinding TitleBar}"
                                                  WindowDecorationProperties.ElementRole="User" />
                            </Grid>
                            <Border Grid.Row="1"
                                    Padding="{Binding BorderThickness, ElementName=PART_Border}">
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Border>
                        </Grid>
                    </Panel>
                </VisualLayerManager>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[TitleBarMode=High]">
            <Setter Property="TitleHeight" Value="50" />
        </Style>
        <Style Selector="^ /template/ Path#PART_ThemeGlyph.light">
            <Setter Property="Fill" Value="{Binding Stroke, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style Selector="^[TitleBarMode=High] /template/ Image#PART_TitleBarIcon">
            <Setter Property="Width" Value="23" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <Style Selector="^[TitleBarMode=High] /template/ TextBlock#PART_Title">
            <Setter Property="FontSize" Value="{DynamicResource WD.TitleFontSize}" />
        </Style>
        <Style Selector="^[TitleBarMode=None] /template/ Grid#PART_NormalTitleBar">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^[TitleBarMode=None] /template/ ContentPresenter#PART_CustomTitleBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:maximized /template/ Border#PART_Border">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="^:maximized /template/ Path#PART_MaximizeGlyph">
            <Setter Property="Data" Value="{StaticResource WD.WindowRestoreGeometry}" />
        </Style>
        <Style Selector="^:maximized /template/ Button#PART_RestoreButton">
            <Setter Property="AutomationProperties.Name" Value="Restore" />
        </Style>
        <Style Selector="^:fullscreen /template/ Border#PART_Border">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="^:fullscreen /template/ Grid#PART_TitleBar">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
